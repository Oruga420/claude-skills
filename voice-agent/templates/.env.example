# Voice agent env vars for the target app. Copy these lines into the app's own env file or
# secret manager and fill them in. Server side only: none of these may reach the browser.

# Required. ElevenLabs API key with Agents (ConvAI) read and write permissions.
ELEVENLABS_API_KEY=

# Required after `npx tsx scripts/sync-voice-agent.ts --create` prints it.
ELEVENLABS_AGENT_ID=

# Optional. LLM id the sync script pushes to the agent (overrides the script's default).
ELEVENLABS_LLM=

# Optional. IANA zone for the spoken date and time sent to the agent; UTC when unset.
TZ=
