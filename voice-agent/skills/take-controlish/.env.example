# take-controlish / take-control-full video settings. Copy to .env in this folder and fill in.
# Real environment variables win over this file. Never commit the filled copy.

# Required for the narrated video (skip both with --no-voice).
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs account.
ELEVENLABS_VOICE_ID=
# Optional. TTS model; default eleven_v3.
ELEVENLABS_MODEL_ID=

# Optional, read from the real environment only: a script that opens a file and prints a line
# containing "verdict":"visible" once it is really on screen. Called as <opener> <path> <title>.
# TAKE_CONTROL_OPENER=
