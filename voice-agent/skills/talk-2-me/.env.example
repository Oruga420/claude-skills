# talk-2-me key. Copy to ~/.claude/talk2me/.env (the engine's state directory, not this
# folder) and fill in, or export it as an environment variable. Never commit the filled copy.

# Required. ElevenLabs API key; pays for text to speech and for Scribe transcription.
ELEVENLABS_API_KEY=

# Optional, read from the real environment only (not from this file):
# TALK2ME_CAMERA=<dshow device name to try first>
# TALK2ME_PROJECT_ROOTS=<folders whose children are projects, ; separated on Windows>
# TALK2ME_DIR=<alternate state directory>
