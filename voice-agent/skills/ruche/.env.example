# /ruche settings. Copy to .env in this folder and fill in what you use.
# Real environment variables win over this file. Never commit the filled copy.

# Required for voice-over, sound effects and generated music.
ELEVENLABS_API_KEY=
# Optional. Any voice id from your ElevenLabs account; empty = an ElevenLabs stock voice.
ELEVENLABS_VOICE_ID=

# Optional. Only needed for scenes with "text": true (readable text in the image), or when
# ComfyUI is down and the budget allows sending the local images to Replicate.
REPLICATE_API_TOKEN=

# Optional local image generation (read from the real environment, not from this file):
# RUCHE_COMFY_URL=http://127.0.0.1:8188
# RUCHE_KREA_UNET=krea2_turbo_nvfp4.safetensors
# RUCHE_KREA_CLIP=qwen3vl_4b_fp8_scaled.safetensors
# RUCHE_KREA_VAE=qwen_image_vae.safetensors
# RUCHE_MAX_USD=1.0
