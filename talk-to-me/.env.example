# talk-to-me settings. Copy to .env next to SKILL.md (or to ~/.claude/talk-to-me/.env)
# and fill in. Real environment variables win over this file. Never commit the filled copy.

# Required. ElevenLabs API key with text-to-speech access.
ELEVENLABS_API_KEY=

# Required. Any voice id from your ElevenLabs account (Voices > the voice > ID).
ELEVENLABS_VOICE_ID=

# Optional. TTS model; default eleven_v3 (falls back to eleven_multilingual_v2 on a 4xx/5xx).
ELEVENLABS_MODEL_ID=
