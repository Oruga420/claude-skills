# Copy to .env (same folder) and fill in. scripts/package.py reads the process
# environment first, then this file. Never commit the real .env.

# ElevenLabs API key. Required unless you render with --no-voice.
ELEVENLABS_API_KEY=

# Voice for the narration: any voice id from your ElevenLabs voice library.
# Required unless you render with --no-voice.
ELEVENLABS_VOICE_ID=

# Optional. ElevenLabs model for the narration. Default: eleven_v3
ELEVENLABS_MODEL_ID=

# Optional. One more .env file to read the keys above from (for example a shared one).
TAKE_CONTROL_ENV_FILE=

# Optional. Your own command to open the HTML pages and the video. It receives the
# file path as its last argument; exit code 0 counts as opened. Empty = OS default
# (start on Windows, open on macOS, xdg-open on Linux).
TAKE_CONTROL_OPEN_CMD=
